{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "${workspaceFolder}/tools/make.exe",
            "args": ["-j4"],
            "options": {
                "env": {
                    "GCC_PATH": "C:/Users/15478/AppData/Local/stm32cube/bundles/gnu-tools-for-stm32/13.3.1+st.9/bin"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build STM32 project with Makefile"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "${workspaceFolder}/tools/make.exe",
            "args": ["clean"],
